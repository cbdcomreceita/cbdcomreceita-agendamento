# NEXT PUBLIC
NEXT_PUBLIC_SITE_URL=https://www.cbdcomreceita.com.br
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CONSULTATION_PRICE=4990

# SERVER-ONLY
SUPABASE_SERVICE_ROLE_KEY=

# CAL.COM
CALCOM_API_KEY=
CALCOM_BASE_URL=https://cal.com/cbdcomreceita

# MERCADO PAGO (sandbox inicialmente)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# META WHATSAPP CLOUD API (quando aprovada)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_APP_SECRET=

# RESEND
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@cbdcomreceita.com.br

# E-mail da equipe (recebe ficha completa após pagamento)
TEAM_EMAIL=contato@cbdcomreceita.com.br

# Webhook do Google Apps Script — recebe linha por agendamento confirmado
# Crie um Apps Script com doPost(e) e cole a URL da implantação aqui.
GOOGLE_SHEETS_WEBHOOK_URL=

# CRON SECRET
CRON_SECRET=

# Validade do PIX em minutos (padrão 120 se ausente/inválido)
PIX_EXPIRATION_MINUTES=120

# Formulário leve de /dados (RG, nascimento e endereço saem pro prontuário —
# Entrega 2). Padrão false: só liga junto com a página de prontuário.
LIGHT_FORM_ENABLED=false

# Lembrete de PIX pendente via WhatsApp (app/api/cron/funnel). Padrão
# false — template ainda em aprovação na Meta. Com a flag desligada, o
# cron só audita o que enviaria, nunca chama a NexTalk.
WHATSAPP_PIX_REMINDER_ENABLED=false

# Nome do template aprovado na Meta para o lembrete de PIX. O original
# "pix_pendente" tinha a URL do botão cadastrada errada (literal "{{1}}"
# duplicado antes do placeholder real) — "pix_pendente2" é a correção,
# resubmetida direto no WhatsApp Manager, em análise. Trocável sem deploy
# se precisar de mais uma revisão.
WHATSAPP_PIX_REMINDER_TEMPLATE_NAME=pix_pendente2

# Nome do template de confirmação na Meta. Default "confirmacao_consulta"
# (atual, só 1 botão — link do Meet). "confirmacao_consulta_v2" adiciona um
# segundo botão de URL com o link do /prontuario — não registrado por este
# código (ver RELATORIO-FINAL.md, Parte 0: texto aprovado não disponível).
# Trocável sem deploy assim que o v2 estiver aprovado.
WHATSAPP_CONFIRMATION_TEMPLATE_NAME=confirmacao_consulta

# Lembrete de prontuário pendente, 12h antes da consulta (Entrega 2).
# Padrão false — "lembrete_prontuario_12h" não foi registrado na Meta
# (mesmo motivo acima). Com a flag desligada, o cron só audita.
WHATSAPP_INTAKE_REMINDER_ENABLED=false
WHATSAPP_INTAKE_REMINDER_TEMPLATE_NAME=lembrete_prontuario_12h

# CUPONS DE CAMPANHA (lista, sem limite de uso, só validade por código)
# Server-only de propósito — nunca prefixar com NEXT_PUBLIC_, ou o código
# vaza no bundle do cliente. JSON array: [{"code","percent","validUntil"}].
# validUntil aceita data (YYYY-MM-DD, vira 23:59:59 America/Sao_Paulo) ou
# datetime ISO completo com offset explícito.
COUPONS=

# Fallback legado (usado só se COUPONS estiver vazio/ausente) — um único
# código.
COUPON_CODE=
COUPON_DISCOUNT_PERCENT=50
COUPON_VALID_UNTIL=
